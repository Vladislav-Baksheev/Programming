<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Contacts" 
        xmlns:local="clr-namespace:View.Converters"
        Width="650"
        Height="400"
        MinWidth="450"
        MinHeight="450" 
        Icon="/ContactsApp_96x96.ico">
    <Window.Resources>
        <Image x:Key="resImage" Source="Resources/photo_placeholder_100x100.png"/>
        <local:BoolInvertedValueConverter x:Key="BoolInvertedValueConverter"/>
        <local:ButtonVisibilityConverter x:Key="ButtonVisibilityConverter"/>
        <DataTemplate x:Key="contactTemplate">
            <StackPanel Margin="3">
                <TextBlock 
                    Text="{Binding Path=FirstName}" 
                    FontSize="12"
                    FontWeight="SemiBold"/>
                <TextBlock 
                    Text="{Binding Path=Phone}"
                    FontSize="10"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding Path=SaveContactsCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1.8*"/>
        </Grid.ColumnDefinitions>

        <Grid Background="#f8f8f8" Margin="8">
            <DockPanel 
                Grid.Column="0" 
                LastChildFill="True">
                <DockPanel DockPanel.Dock="Top">
                    <TextBlock
                        Margin="3"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        Text="Find:"/>
                    <TextBox Width="Auto" Margin="3"/>
                </DockPanel>
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button 
                            x:Name="AddButton" 
                            Content="Add" 
                            Grid.Column="0"
                            Height="25"
                            Margin="3" 
                            Command="{Binding AddContactCommand}"
                            IsEnabled="{Binding Path=IsReadOnly}"/>
                        <Button 
                            x:Name="EditButton" 
                            Content="Edit" 
                            Grid.Column="1"
                            Height="25" 
                            Margin="3" 
                            Command="{Binding EditContactCommand}"
                            IsEnabled="{Binding Path=IsReadOnly}"/>
                        <Button 
                            Validation.ErrorTemplate="{x:Null}"
                            x:Name="RemoveButton" 
                            Content="Remove"  
                            Grid.Column="2"
                            Height="25" 
                            Margin="3" 
                            Command="{Binding RemoveContactCommand}"
                            CommandParameter="{Binding CurrentContact}"
                            IsEnabled="{Binding Path=IsReadOnly}"/>
                        <Button 
                            x:Name="AutoButton" 
                            Content="Generate"                             
                            Grid.Column="3"
                            Height="25" 
                            Margin="3" 
                            Command="{Binding AutoGenerateContactCommand}"
                            IsEnabled="{Binding Path=IsReadOnly}"/>
                    </Grid>
                    <DockPanel>
                        <ListBox 
                            x:Name="usersList" 
                            Margin="3"
                            Validation.ErrorTemplate="{x:Null}"
                            ItemsSource="{Binding Path=Contacts}"
                            SelectedItem="{Binding Path=CurrentContact, UpdateSourceTrigger=PropertyChanged}"
                            ItemTemplate="{StaticResource contactTemplate}">
                        </ListBox>
                    </DockPanel>
                </DockPanel>
            </DockPanel>
        </Grid>
        
        <GridSplitter 
            Grid.Column="1" 
            ShowsPreview="False" 
            Width="3"
            Background="White"
            HorizontalAlignment="Center" 
            VerticalAlignment="Stretch" />

        <Grid Grid.Column="2" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid 
                Validation.ErrorTemplate="{x:Null}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Image 
                    Grid.Row="1"
                    Grid.Column="0" 
                    Width="100" 
                    Height="100"
                    Margin="3"
                    Source="Resources/photo_placeholder_100x100.png"
                    VerticalAlignment="Top"/>
                <TextBlock
                    Grid.Column="1"
                    Margin="3"
                    Text="Name:"/>
                <StackPanel Grid.Column="1" Grid.Row="1">
                    <TextBox 
                    Text="{Binding Path=CurrentContact.FirstName, UpdateSourceTrigger=PropertyChanged}"
                    IsReadOnly="{Binding Path=IsReadOnly, UpdateSourceTrigger=PropertyChanged}"
                    Margin="3"/>
                    <TextBlock 
                    Text="Phone Number:" 
                    Margin="3"/>
                    <TextBox 
                    Text="{Binding Path=CurrentContact.Phone, UpdateSourceTrigger=PropertyChanged}"
                    IsReadOnly="{Binding Path=IsReadOnly, UpdateSourceTrigger=PropertyChanged}"
                    Margin="3"/>
                    <TextBlock 
                    Text="Email:" 
                    Margin="3"/>
                    <TextBox 
                    IsReadOnly="{Binding Path=IsReadOnly, UpdateSourceTrigger=PropertyChanged}"
                    Text="{Binding Path=CurrentContact.Email, UpdateSourceTrigger=PropertyChanged}"
                    Margin="3"/>
                </StackPanel>
            </Grid>
            
            <Button
                x:Name="ApplyButton"
                Width="75"
                Height="25"
                Grid.Row="1" 
                Content="Apply" 
                Margin="50"
                Command="{Binding ApplyContactCommand}"
                IsEnabled="{Binding Path=CurrentContact.HasErrors, 
                Converter={StaticResource BoolInvertedValueConverter}}"
                Visibility="{Binding Path=IsVisible, Converter={StaticResource ButtonVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>
    </Grid>
</Window>
